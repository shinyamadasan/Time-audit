{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chronasense-conversational-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "41465c21d108494ca35271fdcd55e92a"
    }
  ]
}
